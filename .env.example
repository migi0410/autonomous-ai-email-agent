# LLM API Providers
DEEPSEEK_API_KEY=your_deepseek_orcarouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Database (Supabase PostgreSQL / Vercel Postgres)
# Note: If no DB is provided, the agent automatically falls back to local JSON storage!
DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_URL=postgresql://user:password@host:5432/dbname

# SMTP Configuration (Optional: Can also be configured via Web UI)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SECURE=false

# App URL (For webhook & tracking pixel generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000
